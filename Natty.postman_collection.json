            "url": {
              "raw": "http://localhost:5000/api/progress",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "progress"]
            },
            "description": "Récupérer la progression de l'utilisateur"
          }
        },
        {
          "name": "Log Progress",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"caloriesBurned\": 500,\n  \"weight\": 74,\n  \"notes\": \"Bon entraînement cardio\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/progress",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "progress"]
            },
            "description": "Enregistrer une progression"
          }
        }
      ]
    },
    {
      "name": "HEALTH CHECK",
      "item": [
        {
          "name": "Ping Server",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"test\": \"ping\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/_ping_scan",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
              "path": ["api", "_ping_scan"]
            },
            "description": "Vérifier que le serveur répond"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "token",
      "value": "",
      "description": "JWT token auto-rempli après login"
    }
  ]
}
