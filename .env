# ================================
# NATTY BACKEND — Variables d'environnement
# ================================
# Utilisez ce fichier pour la configuration locale (développement)
# IMPORTANT: Ne commitez jamais ce fichier avec des clés secrètes réelles
# IMPORTANT: Ajoutez .env à .gitignore

# =====================
# ENVIRONNEMENT
# =====================
NODE_ENV=development
# Valeurs: development | staging | production

# =====================
# SERVER
# =====================
PORT=5000
HOST=localhost
# URL complète du serveur (utilisée pour les redirects, emails, etc.)
SERVER_URL=http://localhost:5000
# Pour la production: SERVER_URL=https://api.natty.app

# =====================
# BASE DE DONNÉES
# =====================
MONGODB_URI=mongodb://localhost:27017/natty
# Pour développement local MongoDB
# Pour production: MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/natty?retryWrites=true&w=majority

# Alternative MongoDB Atlas (production):
# MONGODB_URI=mongodb+srv://nattydbuser:PASSWORD@natty.1vsjt0f.mongodb.net/natty?retryWrites=true&w=majority&authSource=admin&appName=Natty

# =====================
# AUTHENTIFICATION & SÉCURITÉ
# =====================
# JWT Secret - Générez une clé forte en production
JWT_SECRET=dev-secret-natty-change-in-production
# Pour générer une clé: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Durée d'expiration du JWT
JWT_EXPIRES_IN=7d

# =====================
# reCAPTCHA (Google)
# =====================
# Clé PUBLIQUE (côté frontend)
RECAPTCHA_SITE_KEY=6LcA3kIsAAAAABASKFgG5B5sZaQZvVQTg0yLx0Ps
# Clé SECRÈTE (côté backend) - À PROTÉGER
RECAPTCHA_SECRET_KEY=6LcA3kIsAAAAANkhIGQLhvfnlgJCDhMFPs1gb9Fv

# =====================
# CORS (CORS - Origins autorisées)
# =====================
# En développement: autoriser localhost
# Séparées par des virgules (pas d'espaces)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173
# Format production: CORS_ORIGINS=https://nattyfront.vercel.app,https://natty.app

# =====================
# OpenAI (Chatbot IA)
# =====================
OPENAI_API_KEY=sk-proj-your-api-key-here
# Obtenez la clé depuis: https://platform.openai.com/api-keys
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TIMEOUT_MS=25000
OPENAI_CHAT_MAX_HISTORY=12

# =====================
# LOGGING
# =====================
LOG_LEVEL=debug
# Valeurs: error | warn | info | debug | trace
LOG_FILE=logs/app.log

# =====================
# RATE LIMITING
# =====================
RATE_LIMIT_WINDOW_MS=900000
# Fenêtre de temps en millisecondes (900000 = 15 minutes)
RATE_LIMIT_MAX_REQUESTS=100
# Nombre maximum de requêtes par fenêtre

# =====================
# EMAIL (optionnel)
# =====================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM=noreply@natty.app

# =====================
# FEATURES
# =====================
ENABLE_CHATBOT=true
ENABLE_QR_SCANNER=true
ENABLE_RECAPTCHA=true

