# ================================
# NATTY BACKEND — Variables d'environnement (TEMPLATE)
# ================================
# Copiez ce fichier en .env et remplissez les valeurs réelles
# IMPORTANT: .env ne doit JAMAIS être commité (cf. .gitignore)

# =====================
# ENVIRONNEMENT
# =====================
NODE_ENV=development
# Valeurs: development | staging | production

# =====================
# SERVER
# =====================
PORT=5000
HOST=localhost
SERVER_URL=http://localhost:5000

# =====================
# BASE DE DONNÉES
# =====================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/natty
# OU MongoDB Atlas
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/natty?retryWrites=true&w=majority

# =====================
# AUTHENTIFICATION & SÉCURITÉ
# =====================
# JWT_SECRET est OBLIGATOIRE: utilise une valeur longue et aléatoire (>= 32 caractères).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# =====================
# reCAPTCHA (Google)
# =====================
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# =====================
# CORS
# =====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================
# OpenAI
# =====================
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TIMEOUT_MS=25000
OPENAI_CHAT_MAX_HISTORY=12

# =====================
# LOGGING
# =====================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# =====================
# RATE LIMITING
# =====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# =====================
# FEATURES
# =====================
ENABLE_CHATBOT=true
ENABLE_QR_SCANNER=true
ENABLE_RECAPTCHA=true
