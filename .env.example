# ================================
# NATTY BACKEND — Variables d'environnement (TEMPLATE)
# ================================
# Copiez ce fichier en .env et remplissez les valeurs réelles
# IMPORTANT: .env ne doit JAMAIS être commité (cf. .gitignore)

# =====================
# ENVIRONNEMENT
# =====================
NODE_ENV=development
# Valeurs: development | staging | production

# =====================
# SERVER
# =====================
PORT=5000
HOST=localhost
SERVER_URL=http://localhost:5000
# Production: utiliser une URL https (ex: https://api.natty.app)

# =====================
# BASE DE DONNÉES
# =====================
# Local MongoDB
MONGODB_URI=mongodb://localhost:27017/natty
# OU MongoDB Atlas
# MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/natty?retryWrites=true&w=majority

# =====================
# AUTHENTIFICATION & SÉCURITÉ
# =====================
# JWT_SECRET est OBLIGATOIRE: utilise une valeur longue et aléatoire (>= 32 caractères).
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=7d

# Cookie auth (JWT en cookie httpOnly)
# - strict: le plus restrictif
# - lax: recommandÃ© si navigation classique
# - none: requis si frontend et backend sont sur des domaines diffÃ©rents (nÃ©cessite HTTPS)
COOKIE_SAMESITE=lax

# Reverse proxy / HTTPS
# Mettre Ã  1 en prod derriÃ¨re un proxy (Render/Vercel/Railway/Nginx...) pour que `req.secure` fonctionne.
TRUST_PROXY=0
# Redirige automatiquement HTTP -> HTTPS en production.
ENFORCE_HTTPS=1

# =====================
# reCAPTCHA (Google)
# =====================
RECAPTCHA_SITE_KEY=your-site-key
RECAPTCHA_SECRET_KEY=your-secret-key

# Captcha (recommended: hCaptcha)
# CAPTCHA_PROVIDER=hcaptcha | recaptcha
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_ENABLED=true
# Secret key (server-side). For reCAPTCHA you can keep using RECAPTCHA_SECRET_KEY, but CAPTCHA_SECRET_KEY is preferred.
CAPTCHA_SECRET_KEY=your-captcha-secret-key

# =====================
# CORS
# =====================
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# =====================
# OpenAI
# =====================
OPENAI_API_KEY=your-openai-api-key
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TIMEOUT_MS=25000
OPENAI_CHAT_MAX_HISTORY=12

# =====================
# LOGGING
# =====================
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# =====================
# RATE LIMITING
# =====================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Global rate limiting (API)
GLOBAL_LIMIT_WINDOW_MS=60000
GLOBAL_LIMIT_MAX=100

# Login limiter (anti brute-force)
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX=5
# DISABLE_LOGIN_LIMITER=true

# Chatbot limiter
CHATBOT_LIMIT_WINDOW_MS=60000
CHATBOT_LIMIT_MAX=12

# =====================
# FEATURES
# =====================
ENABLE_CHATBOT=true
ENABLE_QR_SCANNER=true
ENABLE_RECAPTCHA=true
