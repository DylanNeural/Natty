# ================================
# NATTY BACKEND — Variables d'environnement (TEMPLATE)
# ================================
# Copie ce fichier en .env et remplis les vraies valeurs
# IMPORTANT : .env ne doit JAMAIS être commité

# =====================
# ENVIRONNEMENT
# =====================
NODE_ENV=development
# Valeurs : development | staging | production

# =====================
# SERVER
# =====================
PORT=5000
HOST=localhost
SERVER_URL=http://localhost:5000
# Production : SERVER_URL=https://api.natty.app

# =====================
# BASE DE DONNÉES
# =====================
# MongoDB Atlas (recommandé)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/natty?retryWrites=true&w=majority&appName=Natty
# Local : MONGODB_URI=mongodb://localhost:27017/natty

# =====================
# AUTHENTIFICATION & SÉCURITÉ
# =====================
# Obligatoire — générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-min-32-chars
JWT_EXPIRES_IN=7d

# Cookie httpOnly
# strict | lax | none (none requiert HTTPS)
COOKIE_SAMESITE=lax

# Reverse proxy (Render/Railway/Vercel/Nginx) — mettre à 1 en prod
TRUST_PROXY=0
# Rediriger HTTP → HTTPS en production
ENFORCE_HTTPS=1

# =====================
# CAPTCHA
# =====================
CAPTCHA_ENABLED=false
# hcaptcha | recaptcha
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=your-captcha-secret-key

# reCAPTCHA (si CAPTCHA_PROVIDER=recaptcha)
RECAPTCHA_SITE_KEY=your-recaptcha-site-key
RECAPTCHA_SECRET_KEY=your-recaptcha-secret-key

# =====================
# CORS
# =====================
# Séparées par des virgules, sans espaces
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8082

# =====================
# OPENAI (chatbot + scan IA)
# =====================
# Clé depuis : https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_CHAT_TIMEOUT_MS=25000
OPENAI_CHAT_MAX_HISTORY=12

# =====================
# LOGGING
# =====================
# error | warn | info | debug
LOG_LEVEL=debug
LOG_FILE=logs/app.log

# =====================
# RATE LIMITING
# =====================
# Global (toutes les routes /api)
GLOBAL_LIMIT_WINDOW_MS=60000
GLOBAL_LIMIT_MAX=100

# Login (anti brute-force)
LOGIN_LIMIT_WINDOW_MS=900000
LOGIN_LIMIT_MAX=10
# Désactiver en dev si besoin : DISABLE_LOGIN_LIMITER=true

# Chatbot
CHATBOT_LIMIT_WINDOW_MS=60000
CHATBOT_LIMIT_MAX=12

# =====================
# FEATURES FLAGS
# =====================
ENABLE_CHATBOT=true
ENABLE_QR_SCANNER=true
ENABLE_RECAPTCHA=false
