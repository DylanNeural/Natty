# ================================
# NATTY FRONTEND — Variables d'environnement (TEMPLATE)
# ================================
# Copie ce fichier en .env.local et remplis les vraies valeurs

# URL du backend (LAN dev : IP locale, prod : URL Railway/Render)
EXPO_PUBLIC_API_URL=http://192.168.x.x:5000
EXPO_PUBLIC_API_ENDPOINT=/api

# Web push notifications (optionnel)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
